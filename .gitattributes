# Normalise line endings: LF in the repository and in working copies.
* text=auto eol=lf

*.py      text diff=python
*.md      text diff=markdown
*.toml    text
*.yml     text
*.yaml    text
*.json    text
*.sh      text eol=lf
*.ipynb   text eol=lf

# Lock files are generated by pip-compile: collapse them in diffs on GitHub.
requirements.txt      linguist-generated=true
requirements-dev.txt  linguist-generated=true

# Binary artefacts (should not normally be committed at all, see .gitignore)
*.png     binary
*.jpg     binary
*.pdf     binary
*.parquet binary
*.duckdb  binary
