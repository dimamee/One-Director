# One Director — environment template.
#
# Copy to .env (never committed, see .gitignore) or, better, keep the real file
# OUTSIDE the project directory and load it only at start-up (README, "Secrets").
# Never put real values into this file.

# --- Secrets -----------------------------------------------------------------
# Required for the brief generator only (src/one_director/report). The API and
# dashboard can run without it and serve cached briefs.
ANTHROPIC_API_KEY=
# Required. JWT signing key, at least 32 random bytes (e.g. `openssl rand -hex 32`).
APP_SECRET_KEY=
# Required. HMAC key for person/address/phone/IP pseudonyms, at least 32 random
# bytes. Rotating it breaks pseudonym continuity (docs/data-protection.md).
PSEUDONYM_SALT=

# --- Mode --------------------------------------------------------------------
# true = all firm and person identifiers are masked in every response, PDF and UI.
DEMO_MODE=true

# --- Web ---------------------------------------------------------------------
# Comma-separated list of allowed CORS origins, e.g. http://localhost:8501
ALLOWED_ORIGINS=
